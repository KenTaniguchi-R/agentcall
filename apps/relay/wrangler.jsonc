{
  // The configuration the hosted relay at agent-call.app actually deploys with.
  // It is public and complete on purpose: a self-hoster can read exactly what we
  // run, and there is only ever one copy of the bindings to keep in step.
  //
  // What is deliberately absent is `account_id` — `wrangler deploy` takes it
  // from CLOUDFLARE_ACCOUNT_ID in the deploy environment. The Cloudflare API
  // token that grants any actual authority has never been in this repository
  // and never will be. To deploy your own relay instead, start from
  // wrangler.self-host.example.jsonc.
  "name": "agentcall-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Keep the public product site and relay API on one stable origin. Matching
  // landing files are served as static assets. Relay protocol paths always
  // reach the Worker first, even if a future landing asset has the same name.
  "assets": {
    "directory": "../landing",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/.well-known/*"]
  },
  // Prevents a future `wrangler deploy` from silently re-enabling the
  // workers.dev bypass URL, which would let anyone reach the relay directly,
  // skipping the custom-domain route below.
  "workers_dev": false,
  "vars": { "DEPLOYMENT_MODE": "hosted" },
  // The database id is an opaque account-scoped identifier, not a credential:
  // it grants nothing without an API token for the same account, and it cannot
  // be reached from another account. It stays here so this file remains the one
  // description of the hosted deployment rather than half of one.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agentcall",
    "database_id": "7fe0f64a-f146-455c-8099-4116b6d79593",
    "migrations_dir": "migrations"
  }],
  "analytics_engine_datasets": [{
    "binding": "STATUS_READS",
    "dataset": "agentcall_status_reads"
  }],
  "durable_objects": { "bindings": [
    { "name": "HANDLE_DO", "class_name": "HandleDO" },
    { "name": "ROOM_DO", "class_name": "RoomDO" },
    { "name": "RATE_LIMITER_DO", "class_name": "RateLimiterDO" }
  ] },
  "exports": {
    "HandleDO": { "type": "durable-object", "storage": "sqlite" },
    "RoomDO": { "type": "durable-object", "storage": "sqlite" },
    "RateLimiterDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Must stay in step with HOSTED_RELAY_HOST (packages/shared/src/protocol.ts),
  // which is where every other copy of this host now lives. JSONC cannot import
  // the constant, so this literal is the one deliberate duplicate — the
  // hosted-relay-host invariant in scripts/ci-local.sh fails if the two drift.
  "routes": [{ "pattern": "agent-call.app", "custom_domain": true }],
  // Durable recovery eviction delivery. Each alarm drains a bounded page and
  // failed jobs retain exponential backoff state in D1.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Burst/abuse throttling only — the binding's `period` must be 10 or 60
  // seconds (no hourly window like RATE_LIMIT_PER_HOUR on the DO side), so
  // this is a much shorter-window cap than that per-hour call limit.
  "ratelimits": [
    { "name": "CARD_RL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Shared by the two read endpoints (GET status, GET card), keyed by
    // source IP. 60/min is far above any human or agent's real read rate
    // while still putting a ceiling on namespace scraping and on the
    // Durable Object wakeups a status probe causes.
    { "name": "READ_RL", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Roster bundle reads remain native. Credential-checked roster writes use
    // RATE_LIMITER_DO so their window is exact and shared across source IPs.
    { "name": "ROSTER_READ_RL", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ]
}
