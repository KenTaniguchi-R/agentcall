{
  "name": "agentcall-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Prevents a future `wrangler deploy` from silently re-enabling the
  // workers.dev bypass URL, which would let anyone reach the relay directly,
  // skipping the custom-domain route below.
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agentcall",
    "database_id": "f67097f0-2521-4c41-a9d4-1402682038aa",
    "migrations_dir": "migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "HANDLE_DO", "class_name": "HandleDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HandleDO"] }],
  "routes": [{ "pattern": "agentcall.benree.tech", "custom_domain": true }],
  // Burst/abuse throttling only — the binding's `period` must be 10 or 60
  // seconds (no hourly window like RATE_LIMIT_PER_HOUR on the DO side), so
  // this is a much shorter-window cap than that per-hour call limit.
  "ratelimits": [
    { "name": "REGISTER_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CARD_RL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Shared by the two read endpoints (GET status, GET card), keyed by
    // source IP. 60/min is far above any human or agent's real read rate
    // while still putting a ceiling on namespace scraping and on the
    // Durable Object wakeups a status probe causes.
    { "name": "READ_RL", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Roster join verifies a shared secret, so it is a credential-checking
    // endpoint and must not share READ_RL's 60/min read allowance. Keyed by
    // source IP *and* roster id at the call site.
    { "name": "ROSTER_RL", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Recovery issue/redeem/state. Redeem authenticates an offline-guessable
    // credential against a known handle, so it must not share REGISTER_RL's
    // budget. Checked on BOTH a handle key and an IP key at the call site:
    // one key alone lets an attacker grind many handles from one IP, or one
    // handle from many IPs. 3/60s is the tightest the binding allows —
    // `period` accepts only 10 or 60.
    { "name": "RECOVER_RL", "namespace_id": "1005", "simple": { "limit": 3, "period": 60 } }
  ]
}
