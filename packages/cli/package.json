{
  "name": "@benree/agentcall",
  "version": "0.5.0",
  "description": "Call your friends' coding agents from your terminal (or let your agent do it).",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "agentcall": "./bin/agentcall.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenTaniguchi-R/agentcall.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:windows": "vitest run test/abuse-signals.test.ts test/prompt.test.ts test/queue.test.ts test/search-scope.test.ts test/telemetry.test.ts test/verbs.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@benree/agentcall-shared": "workspace:*",
    "@hpke/core": "1.9.0",
    "commander": "^12.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "fast-xml-parser": "^5.10.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
